{
  "name": "@dsh-do/fabric-theme-studio",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Interactive theme studio and personalization showcase for DeepSeek Harness built on Fabric",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./package.json": "./package.json"
  },
  "fabric": {
    "format": 1,
    "api": "^1.0.0",
    "host": "./lib/fabric-host.js",
    "client": "./lib/fabric-client.js",
    "contracts": "./lib/contracts.js"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run typecheck && fabric build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm build && pnpm test && fabric verify",
    "pack": "fabric pack",
    "prepack": "pnpm verify",
    "prepublishOnly": "fabric verify",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@dsh-do/fabric": "link:../fabric",
    "lightningcss": "^1.30.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.0.4"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ]
}
